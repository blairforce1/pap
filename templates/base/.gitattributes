# Line endings. Every text file is stored with LF and checked out with LF on
# every platform. .editorconfig tells editors the same; this makes git agree.
* text=auto eol=lf

# Binary files: never normalised, never diffed as text.
# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
# Archives and packages
*.zip binary
*.gz binary
*.tgz binary
*.7z binary
*.nupkg binary
*.snupkg binary
bun.lockb binary

# Lock files are generated. GitHub collapses them in diffs and leaves them
# out of language statistics.
package-lock.json linguist-generated=true
yarn.lock linguist-generated=true
pnpm-lock.yaml linguist-generated=true
bun.lock linguist-generated=true
bun.lockb linguist-generated=true
packages.lock.json linguist-generated=true

# Parallel branches each add an entry at the top of the changelog. A union
# merge keeps both entries instead of raising a conflict.
CHANGELOG.md merge=union

# Left out of `git archive` and release tarballs: development-only.
.devcontainer export-ignore
.github export-ignore
