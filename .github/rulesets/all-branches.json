{
  "name": "all-branches",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~ALL"
      ],
      "exclude": [
        "refs/heads/renovate/**",
        "refs/heads/dependabot/**"
      ]
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "non_fast_forward"
    }
  ]
}
