// devcontainer.json: one container for every language layer. mise installs
// every toolchain from .config/mise/conf.d/, so there is no language image
// and no language feature; adding a layer adds nothing here (decision 0003).
//
// Everything is pinned: the image and the features by digest, with the
// version beside each, and mise by the sha256 of its versioned install
// script, which carries the checksum of every mise binary it can fetch.
// Renovate reads each feature's version from the comment above it, in the
// form "// <name> <version>.", and moves the comment and the digest together
// (.github/renovate.jsonc); keep that form.
{
  "name": "pap",
  // mcr.microsoft.com/devcontainers/base:2.2.1-trixie: plain Debian 13 with
  // a non-root vscode user, no language toolchain.
  "image": "mcr.microsoft.com/devcontainers/base:2.2.5-trixie@sha256:71b6fe7c4e07ec747a94a72b2a17f2f8c286eaa7b1c59862888df764efb8b6c6",
  // gh and jq are mise pins (.config/mise/conf.d/base.toml), installed by
  // postCreateCommand, so they need no feature. Claude Code is installed by
  // onCreateCommand, below.
  "features": {
    // git 1.3.8. os-provided keeps the git the pinned image ships.
    "ghcr.io/devcontainers/features/git@sha256:fd75977de13a9979000e0e78baf949adb0ca71d2398995fa22e0a36d7e7e7fe2": {
      "version": "os-provided"
    }
  },
  "containerUser": "vscode",
  "remoteUser": "vscode",
  // mise's binary and shims, for terminals, lifecycle commands and
  // extensions alike. The git hooks add the shims themselves (.lefthookrc).
  "remoteEnv": {
    "PATH": "/home/vscode/.local/bin:/home/vscode/.local/share/mise/shims:${containerEnv:PATH}"
  },
  "forwardPorts": [],
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  // First, /tmp: the base image has it 1777, but a feature build under
  // podman leaves it root 0755, and mise, dotnet and go all write there.
  // A no-op under Docker. Then mise 2026.5.12: no official mise feature
  // exists, and the community one fetches unpinned helpers at build time.
  //
  // Last, Claude Code by Anthropic's native installer, into ~/.local/bin
  // (on PATH through remoteEnv). The one tool not pinned, on purpose: it
  // updates itself often, its auto-update stays on, and a pin would only
  // hold it back.
  "onCreateCommand": "{ [ -w /tmp ] || sudo chmod 1777 /tmp; } && curl -fsSL -o /tmp/mise-install.sh https://github.com/jdx/mise/releases/download/v2026.10.25/install.sh && echo '61cb4d61d523a90fc9c479891897f8d0bbf0f622bd909119c06d32cd2202a414  /tmp/mise-install.sh' | sha256sum -c - && sh /tmp/mise-install.sh && rm /tmp/mise-install.sh && curl -fsSL https://claude.ai/install.sh | bash",
  // The clone setup, which fails the create if it fails; then the pap and
  // spec-review plugins, each saying so if it cannot install (offline, say);
  // then pap doctor to show what is left (gh auth login, and claude's own
  // sign-in, are yours), whose result never fails the create. bin/pap is
  // pap's own checkout, which pins no pap of its own.
  "postCreateCommand": "mise trust && mise install && mise run setup && { for p in pap spec-review; do claude plugin install \"$p\" --marketplace blairforce1/pap || echo \"postCreate: could not install the $p plugin; pap doctor says how\"; done; if command -v pap >/dev/null 2>&1; then pap doctor; else sh bin/pap doctor; fi || true; }",
  "customizations": {
    "vscode": {
      // The same list as .vscode/extensions.json; see the base README.
      "extensions": [
        "EditorConfig.EditorConfig",
        "ms-dotnettools.csdevkit",
        "golang.go",
        "dprint.dprint",
        "redhat.vscode-yaml",
        "DavidAnson.vscode-markdownlint",
        "timonwong.shellcheck"
      ]
    }
  }
}
