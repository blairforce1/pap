<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    nuget.config: nuget.org is the only package source. <clear /> drops
    every source a user or machine-level config would add, so a restore
    cannot be redirected to a feed outside the repository. Source mapping
    then says every package id resolves at nuget.org and nowhere else;
    a second source added later needs its own pattern here before any
    package can come from it.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!--
    Signature validation. In require mode a package is extracted only if it
    carries a signature from a signer listed below; an unsigned package, or
    one signed by anyone else, fails restore (NU3004, NU3034). The check
    runs when a package is first extracted into the global packages folder;
    a package already there is not checked again.
  -->
  <config>
    <add key="signatureValidationMode" value="require" />
  </config>
  <trustedSigners>
    <!-- Every package on nuget.org carries the nuget.org repository
         signature. The three certificates are the ones the nuget.org service
         index lists (RepositorySignatures/5.0.0), 2018, 2021 and 2024, and
         are what `dotnet nuget trust source nuget.org` writes. Older
         packages keep the older signatures, so all three stay. Refresh with
         that command when nuget.org rotates again. -->
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
      <certificate fingerprint="0e5f38f57dc1bcc806d8494f4f90fbcedd988b46760709cbeec6f4219aa6157d" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="5a2901d6ada3d18260b9c6dfe2133c95d74b9eef6ae0e5dc334c8454d1477df4" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="1f4b311d9acc115c8dc8018b5a49e00fce6da8e2855f9f014ca6f34570bc482d" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
    </repository>
    <!-- Author signatures, for publishers that sign. Microsoft signs its
         packages; this is the certificate on Microsoft.NET.Test.Sdk and
         its dependencies at 17.14.1. Meziantou.Analyzer and
         Roslynator.Analyzers carry no author signature, only the
         repository one, so they have no entry. A package is trusted when
         any one of its signatures matches an entry, so this entry adds
         nothing while the repository entry stands; it keeps Microsoft
         packages trusted if the repository entry is ever narrowed with
         <owners> or replaced by a proxy's certificate. -->
    <author name="Microsoft">
      <certificate fingerprint="566a31882be208be4422f7cfd66ed09f5d4524a5994f50ccc8b05ec0528c1353" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
    </author>
  </trustedSigners>
</configuration>
