<Project>
  <!--
    Directory.Build.props: build settings for every project below this file.
    MSBuild imports it before each project file, so a project inherits all of
    it and overrides a value only by restating it in its own csproj. Style is
    not set here: .editorconfig owns it, and .globalconfig holds what the
    build enforces beyond it. See README.md in the template.
  -->

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Every warning fails the build: the compiler's, the SDK analyzers'
         at the latest recommended level, the third-party analyzers', and
         the .editorconfig style rules, which EnforceCodeStyleInBuild runs
         in the compiler. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- The XML documentation file is generated for one reason: IDE0005
         (unnecessary using) only runs on build when it exists, as the base
         .editorconfig notes. Generating it also makes the compiler report
         CS1591 on every undocumented public member; whether public members
         need doc comments is a policy this layer does not set, so that one
         warning is off. The file lands in bin/, which is ignored. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- MA0007, the trailing comma in a multi-line initialiser, collection
         expression or switch expression: info by default, an error here.
         This is the one analyzer severity not set in .globalconfig, because
         dotnet format's third-party pass reads compilation options and
         .editorconfig and not that file (measured on SDK 10.0.401); set
         here, the build refuses a missing comma and dotnet format adds it. -->
    <WarningsAsErrors>$(WarningsAsErrors);MA0007</WarningsAsErrors>

    <!-- Reproducible output: the same sources and inputs give the same
         binary. On CI the source paths are normalised too, so the build
         machine's directory layout reaches nothing. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' != ''">true</ContinuousIntegrationBuild>

    <!-- Every project writes packages.lock.json on restore; commit it. On CI
         the lock file is an input, not an output: a restore that would have
         to change it fails (NU1004) instead of resolving something else. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' != ''">true</RestoreLockedMode>

    <!-- Restore audit: every package in the graph, direct or transitive, is
         checked against the advisory database, at every severity from low
         up. An advisory is a warning (NU1901-NU1904), and
         TreatWarningsAsErrors turns it into a failed restore. -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>

    <!-- NU3018 stays a warning. nuget.config requires a trusted signature on
         every package, and in that mode NuGet also checks revocation on each
         signature. On Linux the check reports "revocation status unknown"
         for a signature whose certificate has expired, even with every CRL
         reachable and current. Author signatures: xunit.abstractions 2.0.3
         under xunit 2, Microsoft.Bcl.AsyncInterfaces 6.0.0 under xunit.v3.
         The nuget.org repository signature from 2018: NETStandard.Library
         1.6.1 (measured on SDK 10.0.401). NuGet reports it as a warning;
         TreatWarningsAsErrors would fail every such restore. The refusals that matter are other codes and
         stay errors: an unsigned package is NU3004, a package signed by
         anyone not in trustedSigners is NU3034. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU3018</WarningsNotAsErrors>
  </PropertyGroup>

  <!--
    Third-party analyzers, run in every project. Versions are pinned in
    Directory.Packages.props. Severities are set in .globalconfig, where
    every rule an IDE rule in .editorconfig already covers is switched off;
    the one exception, MA0007, is above.
  -->
  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>
